# Copy to .env (git-ignored) and fill in locally. Names only; never commit values.
# honcho loads .env automatically.

# Local ports used by `honcho start`.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Where the Next.js server proxies /backend/* to.
BACKEND_URL=http://localhost:8000

# Read-only sources for the briefing agent (see backend/src/pairprogrammer/sources.py).
# Workspace docs directory (specs, plans, roadmaps); exposed as root "docs".
WORKSPACE_DOCS_DIR=
# Comma-separated local repo checkouts; each is exposed under its directory name
# (names must be unique). Secret and gitignored files in them are never read.
REPO_ROOTS=
