# Copy to .env (git-ignored) and fill in locally. Names only; never commit values.
# honcho loads .env automatically.

# Local ports used by `honcho start`.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Where the Next.js server proxies /backend/* to.
BACKEND_URL=http://localhost:8000

# Read-only Jira (REST API v3, basic auth with a classic API token).
JIRA_SITE=https://frederik-heda.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Read-only GitHub: fine-grained PAT with read access to Pull requests, Contents,
# Checks and Metadata on the owner's repos.
GITHUB_TOKEN=
GITHUB_OWNER=Fredheda
