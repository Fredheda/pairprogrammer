# Copy to .env (git-ignored) and fill in locally. Names only; never commit values.
# honcho loads .env automatically.

# Local ports used by `honcho start`.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend base URL: target of the Next.js /backend/* rewrite and of the
# CopilotKit runtime's AG-UI agent (${BACKEND_URL}/agent).
BACKEND_URL=http://localhost:8000
