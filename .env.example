# Copy to .env (git-ignored) and fill in locally. Names only; never commit values.
# honcho loads .env automatically.

# Local ports used by `honcho start`.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Where the Next.js server proxies /backend/* to.
BACKEND_URL=http://localhost:8000

# Read-only Jira: the hosted Atlassian MCP server, OAuth 2.1. Nothing to set
# here — sign in once in interactive Claude Code (`/mcp` -> Authenticate) on
# the machine running the backend.

# Read-only GitHub: the hosted GitHub MCP server, which takes a fine-grained
# PAT (read: Pull requests, Contents, Checks, Metadata; scoped to the owner's
# repos). GitHub's hosted server has no OAuth flow. No var -> no GitHub tools.
PAIR_GITHUB_TOKEN=
